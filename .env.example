# Copy to `.env` beside this file. Every phase reads THIS file: ADK walks up
# from the agent folder until it finds one, and the commands load it by path.
# A variable already set in the shell wins over this file, everywhere.

# LiteLLM fetches its model map from the network at every import unless told
# not to; this keeps it to the map the pinned version ships.
LITELLM_LOCAL_MODEL_COST_MAP=True

# Which arm every phase runs on: copilot, the arm the talk is given on and the team uses (also the
# arm when this is blank), or gemini.
REVIEW_PROVIDER=copilot
# Model within that provider. Blank = the provider's default (gpt-4.1 / gemini-2.5-flash).
REVIEW_MODEL=

# The copilot arm needs no key. Run `uv run python scripts/copilot_login.py` once: GitHub's device
# flow caches a token under ~/.config/litellm/github_copilot and LiteLLM reads it.

# The gemini arm: an AI Studio key.
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=

# Phase 7 only: the second opinion's own model (`--verify`). Blank = REVIEW_MODEL.
REVIEW_VERIFIER_MODEL=

# Phase 7 only: a second model behind every role's first, tried on a 429 or a 5xx (ADK's FallbackModel).
# On the free tier the quota is per model, so a second model is a second quota. Blank = none.
REVIEW_FALLBACK_MODEL=
